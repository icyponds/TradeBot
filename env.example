# Trading Bot Configuration for Hyperliquid
# Copy this file to .env and fill in your actual values

# ============================================================
# REQUIRED - API Credentials
# ============================================================
HYPERLIQUID_PRIVATE_KEY=your_private_key_here
HYPERLIQUID_WALLET_ADDRESS=your_wallet_address_here
HYPERLIQUID_PUBLIC_ACCOUNT_ADDRESS=your_public_account_address_here

# OPTIONAL - per-strategy subaccount process (python src/main.py --profile NAME).
# Set ONLY in that process's environment; the default process leaves it empty.
# HYPERLIQUID_SUBACCOUNT_ADDRESS=0xyour_subaccount_address
