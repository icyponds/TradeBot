# Trading Bot Configuration for Hyperliquid
# Copy this file to .env and fill in your actual values

# Hyperliquid API Configuration
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_PRIVATE_KEY=your_private_key_here
HYPERLIQUID_WALLET_ADDRESS=your_wallet_address_here
HYPERLIQUID_PUBLIC_ACCOUNT_ADDRESS=your_public_account_address_here

# API Rate Limiting
API_RATE_LIMIT_CPS=10
API_RATE_LIMIT_BURST=20

# API Circuit Breaker
API_CB_FAILURE_THRESHOLD=5
API_CB_RECOVERY_TIMEOUT=30.0

# API Caching (TTL in seconds)
API_CACHE_DEFAULT_TTL=1.0
API_CACHE_MARKET_DATA_TTL=0.5
API_CACHE_ASSET_INFO_TTL=5.0
API_CACHE_POSITIONS_TTL=1.0

# API Health Monitoring
API_HEALTH_CHECK_INTERVAL=30.0
API_HEALTH_UNHEALTHY_THRESHOLD=3
API_HEALTH_WS_STALE_THRESHOLD=60.0
API_HEALTH_LATENCY_WARNING_MS=1000.0

# Dynamic Trading Pair Selection
DYNAMIC_PAIR_SELECTION=true
MIN_OPEN_INTEREST=1000000

SCAN_INTERVAL_MINUTES=60

# Asset Filtering (optional)
EXCLUDED_ASSETS=
INCLUDED_ASSETS=

# Trading Configuration
BASE_CURRENCY=USDC

# Portfolio-based Position Sizing
USE_PORTFOLIO_BASED_SIZING=true
MAX_POSITION_SIZE_USD=100
MAX_POSITION_SIZE_PERCENTAGE=10.0
MAX_POSITIONS_PERCENTAGE=33.33
RISK_PERCENTAGE=10.0
STOP_LOSS_PERCENTAGE=5.0

# Order Monitoring Configuration
ORDER_TIMEOUT_MINUTES=0.5
ENABLE_STALE_ORDER_CLEANUP=true
POSITION_SYNC_INTERVAL=10
ENABLE_POSITION_VALIDATION=true

# Risk Management
MARGIN_BUFFER_PERCENTAGE=20
LIQUIDATION_RISK_THRESHOLD=80

# HIP-3 Perps Configuration (Builder-deployed perpetual markets)
HIP3_ENABLED=true
# List of HIP-3 dex names to enable (comma-separated, leave empty for auto-discover)
HIP3_PERP_DEXS=
HIP3_INCLUDE_IN_PAIR_SELECTION=true
HIP3_MIN_VOLUME=10000
HIP3_MAX_LEVERAGE=5
HIP3_MIN_OPEN_INTEREST=100000

# Spot Trading Configuration
SPOT_ENABLED=true
SPOT_INCLUDE_IN_PAIR_SELECTION=true
SPOT_MIN_VOLUME=50000

# Strategy Configuration
# Quantitative strategies: stat_arb, funding_rate_arbitrage, ou_mean_reversion, momentum_factor
# TA strategies (optional): moving_average, rsi, bollinger_band, supertrend, vwap
ENABLED_STRATEGIES=stat_arb,funding_rate_arbitrage,ou_mean_reversion,momentum_factor

# Timeframe Configuration
STRATEGY_TIMEFRAME=1m
OHLCV_LIMIT=100

# Moving Average Strategy
MA_SHORT_PERIOD=5
MA_LONG_PERIOD=10

# RSI Strategy
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30

# Database Configuration
DATABASE_URL=sqlite:///trading_bot.db

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=trading_bot.log

# Backtesting Configuration
BACKTESTING_ENABLED=false
BACKTEST_START_DATE=2024-01-01
BACKTEST_END_DATE=2024-12-31

# Order Management Configuration
ORDER_WALK_MAX_ATTEMPTS=5
ORDER_WALK_PRICE_STEP=0.02
ORDER_WALK_DELAY=0.5
ORDER_STATUS_TIMEOUT=30

# Data Collection Configuration
PRICE_HISTORY_MAX_LENGTH=1000
OHLCV_HISTORY_MAX_LENGTH=1000

# Strategy Configuration (Advanced)
MA_TREND_STRENGTH_MULTIPLIER=10
MA_VOLATILITY_CAP=2.0
MA_BASE_TAKE_PROFIT_PERCENTAGE=0.06
MA_TREND_ADJUSTMENT_MAX=0.5
MA_VOLATILITY_ADJUSTMENT_MAX=0.3
MA_TAKE_PROFIT_MIN=0.02
MA_TAKE_PROFIT_MAX=0.15

# Leverage Management Configuration
LEVERAGE_BASE=2.0
LEVERAGE_SIGNAL_ADJUSTMENT_MAX=0.5
LEVERAGE_VOLATILITY_MIN=0.1
LEVERAGE_MIN=1.0
LEVERAGE_MAX=10.0
LEVERAGE_MA_STRATEGY_ADJUSTMENT=1.1
LEVERAGE_RSI_STRATEGY_ADJUSTMENT=0.9

# Pair Selection Configuration
MIN_VOLUME_THRESHOLD=10000
MIN_VOLUME_THRESHOLD_STRICT=100000
VOLUME_NORMALIZATION_FACTOR=1000000

# Sophisticated Pair Selection
# Modes: simple, sophisticated, momentum, mean_reversion, balanced
PAIR_SELECTION_MODE=sophisticated

# Score weights (must sum to 1.0) - for "sophisticated" mode
PAIR_WEIGHT_LIQUIDITY=0.25
PAIR_WEIGHT_VOLATILITY=0.20
PAIR_WEIGHT_STRATEGY_FIT=0.25
PAIR_WEIGHT_DIVERSIFICATION=0.15
PAIR_WEIGHT_HISTORICAL=0.15

# Volatility parameters (optimal daily volatility range)
PAIR_VOL_OPTIMAL_MIN=0.02
PAIR_VOL_OPTIMAL_MAX=0.08
PAIR_VOL_LOOKBACK_DAYS=14

# Diversification parameters
PAIR_MAX_CORRELATION=0.7
PAIR_CORRELATION_PENALTY=0.5

# RSI Strategy Configuration
RSI_OVERSOLD_THRESHOLD=30
RSI_OVERBOUGHT_THRESHOLD=70
RSI_NEUTRAL_THRESHOLD=60
RSI_FACTOR_OVERSOLD=1.3
RSI_FACTOR_OVERBOUGHT=0.7
RSI_VOLATILITY_ADJUSTMENT_MAX=0.3

# Log Management Configuration
PURGE_LOGS_ON_STARTUP=true
CLEAR_CURRENT_LOG_ON_STARTUP=true
MAX_LOG_FILES=10
MAX_LOG_AGE_DAYS=7
MAX_LOG_FILE_SIZE_MB=50 