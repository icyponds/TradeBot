# Trading Bot Configuration for Hyperliquid
# Copy this file to .env and fill in your actual values

# Hyperliquid API Credentials (REQUIRED)
HYPERLIQUID_PRIVATE_KEY=your_private_key_here
HYPERLIQUID_WALLET_ADDRESS=your_wallet_address_here
HYPERLIQUID_PUBLIC_ACCOUNT_ADDRESS=your_public_account_address_here

# Logging
LOG_LEVEL=INFO

# Asset Filtering (optional - uncomment to use)
# EXCLUDED_ASSETS=BADCOIN,SCAMTOKEN
# INCLUDED_ASSETS=BTC,ETH,SOL

# All other settings use sensible defaults from src/config/settings.py
# Override here only if needed
