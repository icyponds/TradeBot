# Trading Bot Configuration for Hyperliquid
# Copy this file to .env and fill in your actual values

# Hyperliquid API Configuration
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
HYPERLIQUID_PRIVATE_KEY=your_private_key_here
HYPERLIQUID_WALLET_ADDRESS=your_wallet_address_here

# Dynamic Trading Pair Selection
DYNAMIC_PAIR_SELECTION=true
MIN_OPEN_INTEREST=1000000
MAX_OPEN_INTEREST=100000000
MAX_PAIRS_TO_TRADE=10
SCAN_INTERVAL_MINUTES=60

# Asset Filtering (optional)
EXCLUDED_ASSETS=
INCLUDED_ASSETS=

# Trading Configuration
BASE_CURRENCY=USDC
MAX_POSITION_SIZE=50
RISK_PERCENTAGE=2.0
STOP_LOSS_PERCENTAGE=5.0
TAKE_PROFIT_PERCENTAGE=10.0

# Strategy Configuration
ENABLED_STRATEGIES=moving_average,rsi

# Timeframe Configuration
STRATEGY_TIMEFRAME=1m
OHLCV_LIMIT=100

# Moving Average Strategy
MA_SHORT_PERIOD=5
MA_LONG_PERIOD=10

# RSI Strategy
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30

# Database Configuration
DATABASE_URL=sqlite:///trading_bot.db

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=trading_bot.log

# Backtesting Configuration
BACKTESTING_ENABLED=false
BACKTEST_START_DATE=2024-01-01
BACKTEST_END_DATE=2024-12-31 