# Trading Bot Configuration for Hyperliquid
# Copy this file to .env and fill in your actual values

# ============================================================
# REQUIRED - API Credentials
# ============================================================
HYPERLIQUID_PRIVATE_KEY=your_private_key_here
HYPERLIQUID_WALLET_ADDRESS=your_wallet_address_here
HYPERLIQUID_PUBLIC_ACCOUNT_ADDRESS=your_public_account_address_here

# ============================================================
# OPTIONAL - Override defaults from src/config/settings.py
# ============================================================

# Logging
LOG_LEVEL=INFO

# Strategies (comma-separated, default: all enabled)
# ENABLED_STRATEGIES=ou_mean_reversion,momentum_factor,stat_arb,funding_rate_arbitrage

# Asset Filtering
# EXCLUDED_ASSETS=PURR,HFUN
# INCLUDED_ASSETS=BTC,ETH,SOL

# Pair Selection Thresholds
# MIN_OPEN_INTEREST=500000
# MIN_VOLUME=1000000

# Position Sizing (% of equity)
# MAX_POSITION_SIZE_USD=50
# MAX_POSITION_SIZE_PERCENTAGE=10.0
# MAX_POSITIONS_PERCENTAGE=80.0

# Leverage Bounds
# LEVERAGE_BASE=3.0
# LEVERAGE_MIN=1.5
# LEVERAGE_MAX=5.0

# Risk Management
# MAX_ACCOUNT_LOSS_PER_TRADE=3.0
# EMERGENCY_PORTFOLIO_LOSS_PCT=10.0

# Regime + Change-Point Filters (optional)
# These help the bot adapt exposure across market regimes and avoid opening new mean-reversion/stat-arb
# entries during abrupt market shifts.
#
# REGIME_ALLOCATOR_ENABLED=true
# REGIME_PROXY_SYMBOL=BTC
# REGIME_TIMEFRAME=15m
# REGIME_LOOKBACK=220
# REGIME_RETRAIN_MINUTES=30
# REGIME_HYSTERESIS_THRESHOLD=0.60
# REGIME_MIN_SWITCH_MINUTES=15
#
# CHANGEPOINT_ENABLED=true
# CHANGEPOINT_PROXY_SYMBOL=BTC
# CHANGEPOINT_TIMEFRAME=15m
# CHANGEPOINT_COOLDOWN_MINUTES=20
# CHANGEPOINT_APPLY_TO=ou_mean_reversion,stat_arb
# CHANGEPOINT_DELTA=0.0
# CHANGEPOINT_THRESHOLD=0.02
# CHANGEPOINT_ALPHA=0.99

# Strategy exploration (optional)
# Used to ensure each strategy gets enough trades for sample-size confidence.
# STRATEGY_EXPLORATION_ENABLED=true
# STRATEGY_EXPLORATION_EPSILON=0.15
# STRATEGY_EXPLORATION_MIN_TRADES=20
# STRATEGY_EXPLORATION_SIZE_SCALE=0.30
# STRATEGY_EXPLORATION_CLOSE_DELTA=0.10
# Keep this fraction of available capital in reserve for exploration trades (0.0 - 1.0)
# STRATEGY_EXPLORATION_RESERVE_PCT=0.10

# Dashboard
# DASHBOARD_PORT=5050
